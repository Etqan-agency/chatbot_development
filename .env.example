# --- Deployment identity -----------------------------------------------------
# The two public hostnames. Independent values, NOT derived from a shared base.
#
# Both need A records pointing at this host BEFORE the first bring-up -- not
# merely before some later certificate step, because there is no separate
# certificate step. Traefik is the edge, terminates TLS, and requests its own
# certificates over HTTP-01 the first time a handshake arrives for a hostname
# one of its routers claims. There is no nginx and no certbot on the host.
#
# Do NOT add AAAA records unless Docker is publishing on IPv6 as well: Let's
# Encrypt prefers AAAA when present, and a record that nothing answers on makes
# validation fail. See docs/DEPLOY.md section 2.7.
API_HOST=chatbot-api.zaychain.com
APP_HOST=chatbot.zaychain.com

# Path under /media/ that deploy.sh writes through `web` and reads back through
# `media` as a smoke check. It proves the shared volume and the priority router
# in one probe -- /media/ is the route that silently regressed when the
# all-in-one nginx was replaced. Leave the default unless it collides with real
# tenant content.
MEDIA_PROBE_PATH=probe/health.txt

# Image tag to run. CD sets this to the commit SHA; `latest` is a convenience
# for manual bring-up only -- never rely on it for a real deploy, because it
# makes "what is running?" unanswerable.
IMAGE_TAG=latest

# --- Database ----------------------------------------------------------------
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
# Must match the three values above.
DATABASE_URL=postgres://chatbot:CHANGEME@db:5432/chatbot

# --- Django ------------------------------------------------------------------
SECRET_KEY=
DEBUG=False
# MUST include both hostnames and localhost: Traefik's load-balancer healthcheck
# sends Host: ${API_HOST}, the dashboard's nginx proxies with Host: ${APP_HOST},
# and the container's own HEALTHCHECK probes over loopback. Miss one and every
# backend reads as unhealthy.
ALLOWED_HOSTS=chatbot-api.zaychain.com,chatbot.zaychain.com,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://chatbot-api.zaychain.com,https://chatbot.zaychain.com
# The dashboard is same-origin, so this is only for third-party browser
# clients. Leave empty unless one exists.
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=https://chatbot.zaychain.com

# --- Production behaviour ----------------------------------------------------
INGESTION_MODE=celery
RAG_VECTOR_BACKEND=pgvector
USE_REDIS_CACHE=True
REDIS_URL=redis://redis:6379/0
UNANSWERED_CAPTURE_MODE=celery

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
OPENAI_API_KEY=

# --- External API sync -------------------------------------------------------
# Pages followed for a paginated source (the whole source is imported).
API_SYNC_MAX_PAGES=200
# Describe each synced record with the LLM, indexed next to the raw record.
API_SYNC_AI_ANALYSIS=True
API_SYNC_ANALYSIS_WORKERS=4

# --- Billing -----------------------------------------------------------------
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=click.ai <no-reply@example.com>

# --- Nothing here configures Traefik -----------------------------------------
# Traefik's static configuration is traefik/traefik.yml and nothing else -- the
# traefik service deliberately has no `env_file: .env`, so no variable in this
# file reaches that container. (Giving the gateway this file would hand it
# every application secret below for no reason.)
#
# In particular the ACME account email and the staging-CA override live in
# traefik/traefik.yml. An earlier version of this file advertised
# TRAEFIK_CERTIFICATESRESOLVERS_* variables here; they never had any effect.
