# --- Deployment identity -----------------------------------------------------
# The two public hostnames. Independent values, NOT derived from a shared base:
# etqanbackend.tech is used by several unrelated servers and this host owns only
# these two names.
#
# Both need A records pointing at this host before certbot runs. They are NOT a
# precondition for a deploy -- nginx terminates TLS and certbot issues the
# certificates, so nothing in the deploy path talks to Let's Encrypt.
API_HOST=api.chatbot-demo.etqanbackend.tech
APP_HOST=app.chatbot-demo.etqanbackend.tech

# Path under /media/ that deploy.sh writes through `web` and reads back through
# `media` as a smoke check. It proves the shared volume and the priority router
# in one probe -- /media/ is the route that silently regressed when the
# all-in-one nginx was replaced. Leave the default unless it collides with real
# tenant content.
MEDIA_PROBE_PATH=probe/health.txt

# Image tag to run. CD sets this to the commit SHA; `latest` is a convenience
# for manual bring-up only -- never rely on it for a real deploy, because it
# makes "what is running?" unanswerable.
IMAGE_TAG=latest

# --- Database ----------------------------------------------------------------
POSTGRES_DB=chatbot
POSTGRES_USER=chatbot
POSTGRES_PASSWORD=
# Must match the three values above.
DATABASE_URL=postgres://chatbot:CHANGEME@db:5432/chatbot

# --- Django ------------------------------------------------------------------
SECRET_KEY=
DEBUG=False
# MUST include both hostnames and localhost: Traefik's load-balancer healthcheck
# sends Host: ${API_HOST}, the dashboard's nginx proxies with Host: ${APP_HOST},
# and the container's own HEALTHCHECK probes over loopback. Miss one and every
# backend reads as unhealthy.
ALLOWED_HOSTS=api.chatbot-demo.etqanbackend.tech,app.chatbot-demo.etqanbackend.tech,localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://api.chatbot-demo.etqanbackend.tech,https://app.chatbot-demo.etqanbackend.tech
# The dashboard is same-origin, so this is only for third-party browser
# clients. Leave empty unless one exists.
CORS_ALLOWED_ORIGINS=
FRONTEND_URL=https://app.chatbot-demo.etqanbackend.tech

# --- Production behaviour ----------------------------------------------------
INGESTION_MODE=celery
RAG_VECTOR_BACKEND=pgvector
USE_REDIS_CACHE=True
REDIS_URL=redis://redis:6379/0
UNANSWERED_CAPTURE_MODE=celery

# --- LLM ---------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-large
OPENAI_API_KEY=

# --- External API sync -------------------------------------------------------
# Pages followed for a paginated source (the whole source is imported).
API_SYNC_MAX_PAGES=200
# Describe each synced record with the LLM, indexed next to the raw record.
API_SYNC_AI_ANALYSIS=True
API_SYNC_ANALYSIS_WORKERS=4

# --- Billing -----------------------------------------------------------------
PADDLE_ENV=production
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=

# --- Email -------------------------------------------------------------------
# Leave EMAIL_HOST empty and mail is printed to the container log instead of
# sent. On 587 keep TLS on and SSL off; on 465 swap them -- Django refuses to
# start if both are true.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
# Seconds to wait on the relay. Sends are synchronous, so an unreachable host
# with no timeout hangs signup rather than failing it.
EMAIL_TIMEOUT=10
# Must be a sender the provider has verified. Gmail rewrites this to
# EMAIL_HOST_USER unless it is registered there under "Send mail as".
DEFAULT_FROM_EMAIL=click.ai <no-reply@example.com>

# --- Local verification only -------------------------------------------------
# Traefik reads static config from env vars too. Point ACME at Let's Encrypt
# STAGING when testing locally, or repeated failures against the production CA
# will burn the real rate limit. Leave UNSET in production.
# TRAEFIK_CERTIFICATESRESOLVERS_LETSENCRYPT_ACME_CASERVER=https://acme-staging-v02.api.letsencrypt.org/directory
